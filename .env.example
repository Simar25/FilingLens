# SEC requires every program that downloads from EDGAR to identify itself with
# a name and a real contact email. Copy this file to ".env" and fill in yours.
# (.env is listed in .gitignore, so it never gets uploaded to GitHub.)
SEC_USER_AGENT="Your Name your.email@example.com"

# Step 2: the AI model that writes answers (see filinglens/llm.py).
# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: another provider instead of Gemini:
#   "groq"   Groq's free tier (about 1,000 requests a day), needs GROQ_API_KEY below
#   "ollama" a free local model on your GPU, no limits
# LLM_PROVIDER="groq"
# Free Groq API key: https://console.groq.com/keys
# GROQ_API_KEY=""
# Optional: a different model, e.g. "gemini-3.5-flash-lite" (a separate free limit),
# "openai/gpt-oss-20b" (Groq) or "qwen2.5:7b" (Ollama).
# LLM_MODEL=""
